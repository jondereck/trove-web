NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Object Storage — public media URLs (no secrets). Keeps image bytes off Vercel.
# NEXT_PUBLIC_NEON_STORAGE_ENDPOINT=https://br-….storage.c-….aws.neon.tech
# NEXT_PUBLIC_NEON_STORAGE_BUCKET=media
# Server upload still needs NEON_STORAGE_ACCESS_KEY_ID / SECRET / ENDPOINT / BUCKET.

# Mobile Trove .env.local names also work:
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
