NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Object Storage — public media URLs (no secrets). Keeps image bytes off Vercel.
# NEXT_PUBLIC_NEON_STORAGE_ENDPOINT=https://br-….storage.c-….aws.neon.tech
# NEXT_PUBLIC_NEON_STORAGE_BUCKET=media
# Server upload still needs NEON_STORAGE_ACCESS_KEY_ID / SECRET / ENDPOINT / BUCKET.

# RevenueCat webhook → Neon entitlements (POST /api/rc-webhook).
# Point the RevenueCat webhook at https://web-trove.vercel.app/api/rc-webhook
# with the Authorization header set to the RAW RC_WEBHOOK_SECRET value.
# RC_WEBHOOK_SECRET=
# RC_API_KEY=sk_...

# Optional: reverse-proxy Vercel /api/* to Neon Functions (co-located with Postgres).
# NEON_FN_SYNCWATCH_URL=https://br-…-syncwatch.compute.c-3.ap-southeast-1.aws.neon.tech
# NEON_FN_AI_URL=https://br-…-ai.compute.c-3.ap-southeast-1.aws.neon.tech
# NEON_FN_JEV_URL=https://br-…-jev.compute.c-3.ap-southeast-1.aws.neon.tech
# NEON_FN_OG_URL=https://br-…-og.compute.c-3.ap-southeast-1.aws.neon.tech
# NEON_FN_RCWEBHOOK_URL=https://br-…-rcwebhook.compute.c-3.ap-southeast-1.aws.neon.tech
# NEON_FN_NEONBACKUP_URL=https://br-…-neonbackup.compute.c-3.ap-southeast-1.aws.neon.tech

# Cross-device sync: watch (default, cheap watermarks) | realtime (PG18 + Neon Realtime)
# NEXT_PUBLIC_SYNC_MODE=watch
# NEON_REALTIME_URL=
# NEON_REALTIME_SECRET=

# Neon AI Gateway (chat + Jev decisions). Preferred over OPENAI_API_KEY in prod.
# NEON_AI_GATEWAY_BASE_URL=https://br-…-api.ai.c-….aws.neon.tech
# NEON_AI_GATEWAY_TOKEN=nt_live_…
# AI_CHAT_MODEL=gpt-5-mini
# AI_JEV_MODEL=typesafeai-jev-1-14-0

# Mobile Trove .env.local names also work:
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
